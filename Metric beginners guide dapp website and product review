<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#080b14" />
  <meta name="description" content="Metric Hub is an independent community-built dashboard for exploring the Metric DeFi ecosystem." />
  <title>Metric Hub — Explore the Metric ecosystem</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#080b14;--panel:#101625;--panel2:#141d2e;--line:rgba(160,177,210,.13);--muted:#8793aa;--text:#f4f6fb;--purple:#a78bfa;--blue:#6ea8fe;--green:#42d6a4;--radius:18px}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 75% -10%,rgba(100,75,190,.18),transparent 34%),var(--bg);color:var(--text);font-family:"DM Sans",sans-serif}
    a{color:inherit;text-decoration:none}button{font:inherit}.shell{display:flex;min-height:100vh}.sidebar{width:248px;position:fixed;inset:0 auto 0 0;background:rgba(10,14,25,.94);border-right:1px solid var(--line);padding:25px 17px;display:flex;flex-direction:column;z-index:5;backdrop-filter:blur(16px)}
    .brand{display:flex;align-items:center;gap:11px;padding:0 8px 30px}.brand-mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(145deg,#8b6cf0,#4c58ad);display:grid;place-items:center;font:700 21px "Space Grotesk";box-shadow:0 8px 25px #7b61df35}.brand-name{font:700 16px "Space Grotesk";letter-spacing:.06em}.brand-sub{font-size:10px;color:var(--muted);margin-top:3px;letter-spacing:.08em;text-transform:uppercase}
    .nav-label{font-size:10px;text-transform:uppercase;letter-spacing:.15em;color:#68758d;padding:13px 12px 9px}.nav{display:grid;gap:5px}.nav a{padding:11px 12px;border-radius:11px;color:#a8b2c7;font-size:13px;display:flex;align-items:center;gap:12px;transition:.2s}.nav a:hover,.nav a.active{background:linear-gradient(90deg,#8b6cf022,#6ea8fe0b);color:#fff}.nav a.active{box-shadow:inset 2px 0 var(--purple)}.ico{width:18px;text-align:center;font-size:16px;color:#a996ef}.side-bottom{margin-top:auto}.network-card{padding:13px;border:1px solid var(--line);border-radius:13px;background:#111827}.network-card small{color:var(--muted);display:block;margin-bottom:7px}.network-state{font-size:12px;color:#d5dbea;display:flex;align-items:center;gap:8px}.dot{width:7px;height:7px;border-radius:50%;background:#e3b45d;box-shadow:0 0 12px #e3b45d80}
    .main{margin-left:248px;width:calc(100% - 248px);padding:0 38px 50px}.topbar{height:82px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:15px}.crumb{font-size:12px;color:var(--muted)}.top-actions{display:flex;align-items:center;gap:10px}.status{font-size:11px;color:#c5cce0;border:1px solid var(--line);padding:8px 11px;border-radius:30px}.connect{border:0;border-radius:11px;padding:10px 15px;color:white;background:linear-gradient(110deg,#795bd7,#526ed1);font-weight:700;font-size:12px;cursor:pointer;box-shadow:0 8px 24px #6654c833}.connect:hover{filter:brightness(1.12)}.mobile-brand{display:none}
    .hero{padding:42px 0 28px;display:flex;justify-content:space-between;align-items:flex-end;gap:24px}.eyebrow{color:#b7a4ff;text-transform:uppercase;letter-spacing:.16em;font-size:10px;font-weight:700;display:flex;align-items:center;gap:8px}.eyebrow:before{content:"";width:18px;height:1px;background:var(--purple)}h1,h2,h3,p{margin-top:0}h1{font:700 clamp(30px,4vw,48px)/1.08 "Space Grotesk";letter-spacing:-.045em;margin:14px 0 12px;max-width:680px}.gradient{background:linear-gradient(100deg,#fff 10%,#bdaaff 58%,#83baff);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{color:#9ca8bd;max-width:600px;line-height:1.7;font-size:14px;margin:0}.hero-actions{display:flex;gap:9px;flex-shrink:0}.btn-secondary{border:1px solid var(--line);background:#111827;color:#dce3f3;border-radius:11px;padding:11px 14px;font-size:12px;font-weight:600;cursor:pointer}.btn-secondary:hover{border-color:#8e7be8}
    .notice{border:1px solid #8d75e633;background:linear-gradient(100deg,#7b5ce714,#263b6514);border-radius:13px;padding:12px 15px;display:flex;gap:11px;align-items:flex-start;color:#b8c2d6;font-size:11px;line-height:1.55;margin:12px 0 22px}.notice strong{color:#e3dcff}.notice-icon{font-size:16px}
    .section-head{display:flex;justify-content:space-between;align-items:end;margin:28px 0 13px}.section-head h2{font:600 17px "Space Grotesk";margin:0}.section-head p{font-size:11px;color:var(--muted);margin:5px 0 0}.text-link{color:#bba8ff;font-size:11px;font-weight:600}
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.card{background:linear-gradient(145deg,rgba(20,29,46,.96),rgba(13,19,32,.96));border:1px solid var(--line);border-radius:var(--radius);padding:18px;min-width:0;box-shadow:0 10px 35px #00000014}.stat-top{display:flex;justify-content:space-between;align-items:center;color:#9aa6bc;font-size:11px}.stat-icon{width:29px;height:29px;border-radius:9px;background:#a78bfa17;color:#bba8ff;display:grid;place-items:center;font-size:14px}.stat-value{font:600 24px "Space Grotesk";margin:16px 0 6px;letter-spacing:-.03em}.stat-foot{font-size:10px;color:#7f8ba2}.tag-demo{color:#e2b96e}
    .content-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(260px,.85fr);gap:14px}.chart-card{padding:19px}.chart-header{display:flex;justify-content:space-between;align-items:flex-start}.chart-header h3,.subcard h3{font:600 14px "Space Grotesk";margin:0 0 5px}.chart-header p{color:var(--muted);font-size:10px;margin:0}.range{display:flex;gap:3px;background:#0b1120;padding:3px;border-radius:8px}.range button{border:0;background:transparent;color:#8290a8;font-size:10px;padding:6px 8px;border-radius:6px;cursor:pointer}.range button.active{background:#282345;color:#d8ceff}.chart-area{height:205px;margin-top:17px;position:relative;overflow:hidden;border-bottom:1px solid var(--line);background:repeating-linear-gradient(to bottom,transparent 0,transparent 50px,#ffffff08 51px)}.chart-area svg{width:100%;height:100%;overflow:visible}.chart-labels{display:flex;justify-content:space-between;color:#68758d;font-size:9px;margin-top:9px}.chart-placeholder{position:absolute;inset:0;display:grid;place-items:center;color:#64718a;font-size:11px;pointer-events:none}
    .side-stack{display:grid;gap:14px}.subcard{padding:18px}.product-list{display:grid;gap:14px;margin-top:17px}.product{display:flex;align-items:center;gap:11px}.product-icon{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:#a78bfa18;color:#c4b5fd}.product-copy{flex:1;min-width:0}.product-copy strong{font-size:11px;display:block}.product-copy small{font-size:9px;color:var(--muted)}.arrow{color:#74819a}
    .pool-table{width:100%;border-collapse:collapse;margin-top:10px}.pool-table th{text-align:left;color:#75829a;font-size:9px;font-weight:500;padding:11px 8px;border-bottom:1px solid var(--line)}.pool-table td{padding:13px 8px;border-bottom:1px solid #ffffff0a;font-size:11px;color:#d4dbea}.pool-name{display:flex;align-items:center;gap:8px;font-weight:600}.token-pair{width:27px;height:27px;border-radius:50%;background:linear-gradient(135deg,#7361c9,#293e77);display:grid;place-items:center;font-size:9px}.muted{color:var(--muted)!important}.pool-empty{text-align:center;padding:25px;color:#8190a8;font-size:11px}
    .bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.feature{display:flex;gap:13px;align-items:flex-start}.feature-icon{width:37px;height:37px;border-radius:12px;display:grid;place-items:center;background:#6ea8fe14;color:#8db8ff;font-size:16px;flex-shrink:0}.feature h3{font:600 13px "Space Grotesk";margin:1px 0 6px}.feature p{font-size:10px;line-height:1.6;color:var(--muted);margin:0}
    footer{margin-top:36px;padding:18px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;color:#68758d;font-size:10px}.footer-links{display:flex;gap:17px}
    .toast{position:fixed;bottom:22px;right:22px;background:#1a2437;border:1px solid #a78bfa55;padding:13px 16px;border-radius:12px;color:#e9e5ff;font-size:12px;box-shadow:0 15px 45px #0008;opacity:0;transform:translateY(10px);transition:.25s;pointer-events:none;z-index:20}.toast.show{opacity:1;transform:translateY(0)}
    @media(max-width:1100px){.stats{grid-template-columns:repeat(2,1fr)}.main{padding:0 25px 40px}.hero{align-items:flex-start;flex-direction:column}.hero-actions{margin-top:3px}}
    @media(max-width:760px){.sidebar{width:70px;padding:18px 10px}.brand{padding:0 6px 26px}.brand-name,.brand-sub,.nav-label,.nav-text,.network-card{display:none}.brand-mark{width:40px;height:40px}.nav a{justify-content:center;padding:12px 5px;font-size:17px}.ico{font-size:18px}.main{margin-left:70px;width:calc(100% - 70px);padding:0 17px 35px}.topbar{height:68px}.status{display:none}.content-grid{grid-template-columns:1fr}.bottom-grid{grid-template-columns:1fr}.hero{padding-top:30px}.hero-actions{width:100%}.hero-actions>*{flex:1}.pool-table{min-width:570px}.table-wrap{overflow-x:auto}.footer-links{display:none}}
    @media(max-width:430px){.stats{gap:9px}.card{padding:14px}.stat-value{font-size:20px}.stat-top{font-size:10px}.hero p{font-size:12px}.topbar .crumb{font-size:10px}.connect{padding:9px 11px;font-size:11px}}
  </style>
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <a class="brand" href="#overview" aria-label="Metric Hub home"><div class="brand-mark">M</div><div><div class="brand-name">METRIC HUB</div><div class="brand-sub">Independent ecosystem</div></div></a>
    <div class="nav-label">Workspace</div>
    <nav class="nav">
      <a class="active" href="#overview"><span class="ico">▦</span><span class="nav-text">Overview</span></a>
      <a href="#analytics"><span class="ico">⌁</span><span class="nav-text">Analytics</span></a>
      <a href="#pools"><span class="ico">◈</span><span class="nav-text">Explore Pools</span></a>
      <a href="#portfolio"><span class="ico">◉</span><span class="nav-text">My Portfolio</span></a>
      <a href="#points"><span class="ico">✧</span><span class="nav-text">Points & Rewards</span></a>
    </nav>
    <div class="nav-label">Discover</div>
    <nav class="nav">
      <a href="#products"><span class="ico">▧</span><span class="nav-text">Products</span></a>
      <a href="#learn"><span class="ico">▤</span><span class="nav-text">Learn</span></a>
    </nav>
    <div class="side-bottom"><div class="network-card"><small>Network integration</small><div class="network-state"><span class="dot"></span>To be verified</div></div></div>
  </aside>
  <main class="main" id="overview">
    <header class="topbar">
      <div class="crumb"><span style="color:#d9d1ff">Metric Hub</span> &nbsp;/&nbsp; Overview</div>
      <div class="top-actions"><div class="status">● &nbsp;Independent community project</div><button class="connect" id="connectBtn">Connect wallet</button></div>
    </header>

    <section class="hero">
      <div>
        <div class="eyebrow">Metric ecosystem, in one place</div>
        <h1>Explore DeFi with <span class="gradient">more clarity.</span></h1>
        <p>Discover Metric products, explore active liquidity pools and understand protocol activity through a single, community-built dashboard.</p>
      </div>
      <div class="hero-actions"><a class="connect" href="#pools">Explore pools ↗</a><a class="btn-secondary" href="#products">Discover products</a></div>
    </section>

    <div class="notice"><span class="notice-icon">ⓘ</span><div><strong>Independent community project.</strong> Metric Hub is not the official Metric website and is not affiliated with or endorsed by Metric. Figures on this first-stage preview are intentionally shown as placeholders until verified data sources and supported networks are confirmed.</div></div>

    <div class="section-head"><div><h2>Ecosystem overview</h2><p>A quick look at protocol activity and liquidity.</p></div><span class="text-link">Data connection: pending</span></div>
    <section class="stats">
      <article class="card"><div class="stat-top"><span>Total value locked</span><span class="stat-icon">◫</span></div><div class="stat-value">—</div><div class="stat-foot tag-demo">Awaiting verified data source</div></article>
      <article class="card"><div class="stat-top"><span>Trading volume</span><span class="stat-icon">↗</span></div><div class="stat-value">—</div><div class="stat-foot">24h volume · not connected</div></article>
      <article class="card"><div class="stat-top"><span>Active pools</span><span class="stat-icon">◈</span></div><div class="stat-value">—</div><div class="stat-foot">Pool indexer not connected</div></article>
      <article class="card"><div class="stat-top"><span>LP fees generated</span><span class="stat-icon">✧</span></div><div class="stat-value">—</div><div class="stat-foot">Awaiting verified data source</div></article>
    </section>

    <div class="section-head" id="analytics"><div><h2>Market activity</h2><p>Historical protocol metrics will appear here when an indexer is connected.</p></div><span class="text-link">Analytics ↗</span></div>
    <section class="content-grid">
      <article class="card chart-card">
        <div class="chart-header"><div><h3>Trading volume</h3><p>Historical volume · illustrative chart only</p></div><div class="range"><button class="active" data-range="7D">7D</button><button data-range="30D">30D</button><button data-range="90D">90D</button></div></div>
        <div class="chart-area">
          <svg viewBox="0 0 700 210" preserveAspectRatio="none" role="img" aria-label="Decorative illustrative volume chart">
            <defs><linearGradient id="fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#9b83f5" stop-opacity=".34"/><stop offset="100%" stop-color="#9b83f5" stop-opacity="0"/></linearGradient></defs>
            <path d="M0 164 C35 154 48 168 78 145 S128 157 155 126 S198 139 230 115 S270 130 305 99 S350 120 380 88 S430 108 465 74 S510 91 540 65 S590 84 620 46 S670 58 700 27 L700 210 L0 210Z" fill="url(#fill)"/>
            <path d="M0 164 C35 154 48 168 78 145 S128 157 155 126 S198 139 230 115 S270 130 305 99 S350 120 380 88 S430 108 465 74 S510 91 540 65 S590 84 620 46 S670 58 700 27" fill="none" stroke="#a78bfa" stroke-width="3" vector-effect="non-scaling-stroke"/>
          </svg>
          <div class="chart-placeholder">Illustrative visualization · not live protocol data</div>
        </div>
        <div class="chart-labels"><span>DAY 01</span><span>DAY 02</span><span>DAY 03</span><span>DAY 04</span><span>DAY 05</span><span>DAY 06</span><span>DAY 07</span></div>
      </article>
      <div class="side-stack">
        <article class="card subcard" id="products"><h3>Explore Metric</h3><p class="muted" style="font-size:10px;margin:0">Discover the ecosystem's core experiences.</p>
          <div class="product-list">
            <div class="product"><div class="product-icon">⇄</div><div class="product-copy"><strong>Swap</strong><small>Token exchange interface</small></div><span class="arrow">↗</span></div>
            <div class="product"><div class="product-icon">◈</div><div class="product-copy"><strong>Active Pools</strong><small>Liquidity and pool analytics</small></div><span class="arrow">↗</span></div>
            <div class="product"><div class="product-icon">▥</div><div class="product-copy"><strong>LP Analytics</strong><small>Understand liquidity performance</small></div><span class="arrow">↗</span></div>
          </div>
        </article>
        <article class="card subcard" id="portfolio"><h3>Your portfolio</h3><p class="muted" style="font-size:10px;line-height:1.6;margin:9px 0 13px">Connect a wallet in a later release to view your addresses, liquidity positions and on-chain activity.</p><button class="btn-secondary" style="width:100%" id="portfolioBtn">Connect to get started</button></article>
      </div>
    </section>

    <div class="section-head" id="pools"><div><h2>Featured liquidity pools</h2><p>Pool data will populate after the Metric network and indexer are verified.</p></div><a class="text-link" href="#learn">How pools work ↗</a></div>
    <section class="card">
      <div class="table-wrap"><table class="pool-table"><thead><tr><th>POOL</th><th>TVL</th><th>24H VOLUME</th><th>FEES</th><th>STATUS</th></tr></thead><tbody><tr><td colspan="5"><div class="pool-empty">No live pool data yet. Connect a verified Metric data source to populate this table.</div></td></tr></tbody></table></div>
    </section>

    <div class="section-head" id="points"><div><h2>More from Metric Hub</h2><p>Tools and education for the wider DeFi community.</p></div></div>
    <section class="bottom-grid">
      <article class="card feature"><div class="feature-icon">✧</div><div><h3>Points & rewards guide</h3><p>A clear information hub for published reward rules, eligibility and official announcements. No unofficial reward estimates presented as facts.</p></div></article>
      <article class="card feature" id="learn"><div class="feature-icon">⌘</div><div><h3>Learn about Active Pools</h3><p>Beginner-friendly explanations of reference prices, liquidity bins, fees, markout and LP performance metrics.</p></div></article>
    </section>

    <footer><span>© 2026 Metric Hub · Independent community project</span><div class="footer-links"><a href="#learn">Documentation</a><a href="#products">Products</a><a href="#overview">Back to top ↑</a></div></footer>
  </main>
</div>
<div class="toast" id="toast" role="status"></div>
<script>
  const toast = document.getElementById('toast');
  let toastTimer;
  function showToast(message){toast.textContent=message;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),3200)}
  document.getElementById('connectBtn').addEventListener('click',()=>showToast('Wallet connection will be enabled after the supported network and wallet flow are verified.'));
  document.getElementById('portfolioBtn').addEventListener('click',()=>showToast('Portfolio tracking is planned for a later development phase.'));
  document.querySelectorAll('.range button').forEach(btn=>btn.addEventListener('click',()=>{
    document.querySelectorAll('.range button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');
    showToast(btn.dataset.range+' view selected. Historical data integration is coming in Phase 2.');
  }));
  document.querySelectorAll('.nav a').forEach(link=>link.addEventListener('click',()=>{
    document.querySelectorAll('.nav a').forEach(a=>a.classList.remove('active'));link.classList.add('active');
  }));
</script>
</body>
</html>
